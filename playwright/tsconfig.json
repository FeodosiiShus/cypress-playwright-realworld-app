{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "@playwright/test"
    ],
    "paths": {
      "@pages/*": [
        "pages/*"
      ],
      "@asserts/*": [
        "assertions/*"
      ]
    }
  }
}